# =====================================================================
# KageSan CRM - web de marketing. Variables de entorno.
# Copia este archivo a .env y ajusta. El lector de .env es propio
# (config/env.py), sin dependencias.
# =====================================================================

# --- Básico ---------------------------------------------------------
DJANGO_SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# URL canónica del sitio. TODO el SEO (canonical, og:url, JSON-LD, sitemap)
# se construye desde aquí, nunca desde el host de la petición.
DJANGO_SITE_URL=https://kagesancrm.com

# --- Marca / contacto (se muestran en la web) ---------------------
# TODO placeholders: sustituir por los datos reales antes de publicar.
KAGESAN_APP_URL=https://app.kagesancrm.com
KAGESAN_CONTACT_EMAIL=hola@kagesancrm.com
KAGESAN_SUPPORT_EMAIL=soporte@kagesancrm.com
# Vacíos = no se renderizan (teléfono, redes).
KAGESAN_CONTACT_PHONE_DISPLAY=
KAGESAN_CONTACT_PHONE_TEL=
KAGESAN_SOCIAL_LINKEDIN=
KAGESAN_SOCIAL_INSTAGRAM=
# Datos para páginas legales (aviso legal / privacidad / cookies).
KAGESAN_LEGAL_ENTITY=[COMPLETAR: razón social]
KAGESAN_LEGAL_TAXID=[COMPLETAR: NIF/CIF]
KAGESAN_LEGAL_ADDRESS=[COMPLETAR: domicilio]

# --- HTTPS / seguridad (producción) -------------------------------
# En local con DEBUG=true no hace falta tocar esto.
DJANGO_HTTPS=true
DJANGO_SSL_HOST=kagesancrm.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://kagesancrm.com,https://www.kagesancrm.com

# --- Base de datos -----------------------------------------------
# Sin estas variables se usa SQLite (db.sqlite3) en local.
# En producción (MySQL en cPanel):
# DJANGO_DB_ENGINE=mysql
# DJANGO_DB_NAME=usuario_kagesan
# DJANGO_DB_USER=usuario_kagesan
# DJANGO_DB_PASSWORD=
# DJANGO_DB_HOST=localhost
# DJANGO_DB_PORT=3306

# --- Email -------------------------------------------------------
# En local/staging el correo va a consola. En producción, SMTP:
# DJANGO_EMAIL_HOST=mail.kagesancrm.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=hola@kagesancrm.com
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_EMAIL_USE_TLS=true
DJANGO_DEFAULT_FROM_EMAIL=KageSan CRM <hola@kagesancrm.com>
DJANGO_CONTACT_RECIPIENTS=hola@kagesancrm.com

# --- Staging ---------------------------------------------------
# Pon true en el subdominio de pruebas (staging.kagesancrm.com).
DJANGO_STAGING=false

# --- Analítica (desactivada por defecto) ---------------------
# Solo se carga si ANALYTICS_ENABLED=true Y hay consentimiento.
ANALYTICS_ENABLED=false
ANALYTICS_GA4_ID=

# --- Alta de admin en el primer deploy (cPanel sin terminal) --
DJANGO_ADMIN_USER=
DJANGO_ADMIN_PASSWORD=
DJANGO_ADMIN_EMAIL=hola@kagesancrm.com
