# =====================================================================
# Variables de entorno de PRODUCCIÓN (kagesancrm.com en Banahosting).
# Se definen en cPanel > Setup Python App > Environment variables
# (o como archivo .env en la raíz de la app; el panel tiene prioridad).
# =====================================================================

DJANGO_SECRET_KEY=            # 50+ caracteres aleatorios
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=kagesancrm.com,www.kagesancrm.com
DJANGO_SITE_URL=https://kagesancrm.com
DJANGO_HTTPS=true
DJANGO_SSL_HOST=kagesancrm.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://kagesancrm.com,https://www.kagesancrm.com

# --- Base de datos MySQL (cPanel) --------------------------------------
DJANGO_DB_ENGINE=mysql
DJANGO_DB_NAME=USUARIO_kagesan
DJANGO_DB_USER=USUARIO_kagesan
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=localhost
DJANGO_DB_PORT=3306

# --- Email (SMTP del buzón del dominio) ------------------------------
DJANGO_EMAIL_HOST=mail.kagesancrm.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=hola@kagesancrm.com
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true
DJANGO_DEFAULT_FROM_EMAIL=KageSan CRM <hola@kagesancrm.com>
DJANGO_CONTACT_RECIPIENTS=hola@kagesancrm.com

# --- Marca / contacto (sustituir por datos reales) ------------------
KAGESAN_APP_URL=https://app.kagesancrm.com
KAGESAN_CONTACT_EMAIL=hola@kagesancrm.com
KAGESAN_SUPPORT_EMAIL=soporte@kagesancrm.com
KAGESAN_CONTACT_PHONE_DISPLAY=
KAGESAN_CONTACT_PHONE_TEL=
KAGESAN_SOCIAL_LINKEDIN=
KAGESAN_SOCIAL_INSTAGRAM=
KAGESAN_LEGAL_ENTITY=
KAGESAN_LEGAL_TAXID=
KAGESAN_LEGAL_ADDRESS=

# --- Otros ---------------------------------------------------------
DJANGO_STAGING=false
ANALYTICS_ENABLED=false
ANALYTICS_GA4_ID=

# --- Alta automática del admin en el primer deploy ----------------
DJANGO_ADMIN_USER=abel
DJANGO_ADMIN_PASSWORD=            # contraseña fuerte
DJANGO_ADMIN_EMAIL=hola@kagesancrm.com
